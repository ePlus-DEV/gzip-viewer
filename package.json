{
  "name": "gzip-jsonl-viewer",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "WXT Chrome extension with real beUI React/Motion components for AEO/SEO auditing",
  "scripts": {
    "postinstall": "wxt prepare && node scripts/generate-icons.mjs",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-extension.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "prezip": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "wxt": "0.21.4",
    "vite": "^7.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "playwright-core": "^1.55.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "overrides": {
    "@vitejs/plugin-react": "5.2.0"
  }
}
