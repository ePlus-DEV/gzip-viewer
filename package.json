{
  "name": "gzip-jsonl-viewer",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "WXT Chrome extension for AEO/SEO audits, LLMS discovery, XML sitemap, product feed and JSONL.GZ cross-tests",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "wxt": "0.21.4",
    "vite": "^7.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
